#version 450

#extension GL_EXT_control_flow_attributes : require

#include "types.glsl"

/* Mamba-1 SSM Scan.
 * d_state = 16, head_dim = 1, n_group = 1.
 * Each invocation handles 1 head.
 * 128 invocations per workgroup (matching CUDA splitD=128).
 * Shared memory: B[16] + C[16] loaded per token.
 * No subgroup operations needed — each thread is independent. */

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly buffer Src0 { float s0[]; };
layout(binding = 1) readonly buffer Src1 { float x[]; };
layout(binding = 2) readonly buffer Src2 { float dt[]; };
layout(binding = 3) readonly buffer Src3 { float A[]; };
layout(binding = 4) readonly buffer Src4 { float B[]; };
layout(binding = 5) readonly buffer Src5 { float C[]; };
layout(binding = 6) readonly buffer Src6 { int ids[]; };
layout(binding = 7) buffer Dst { float d[]; };

layout(push_constant) uniform PushConstants {
    uint nb02; uint nb03; uint nb12; uint nb13;
    uint nb21; uint nb22; uint nb31;
    uint nb42; uint nb43; uint nb52; uint nb53;
    uint s_off;
    uint n_head;
    uint d_head;
    uint n_group;
    uint n_tok;
};

const uint D_STATE = 16;

shared float smemB[D_STATE];
shared float smemC[D_STATE];

float softplus(float x) {
    if (x <= 20.0) {
        return log(1.0 + exp(x));
    }
    return x;
}

void main() {
    const uint head_idx = gl_GlobalInvocationID.x;
    const uint seq_idx  = gl_WorkGroupID.y;

    if (head_idx >= n_head) return;

    /* Address calculation — same layout as Mamba-2 shader */
    const uint s0_base_idx = (uint(ids[seq_idx]) * nb03 + head_idx * nb02) / 4;
    const uint x_base_idx = (seq_idx * nb13 + head_idx * 4) / 4;
    const uint dt_base_idx = (seq_idx * nb22 + head_idx * 4) / 4;
    const uint A_base_idx = (head_idx * nb31) / 4;
    const uint B_base_idx = (seq_idx * nb43) / 4;
    const uint C_base_idx = (seq_idx * nb53) / 4;
    const uint y_base_idx = seq_idx * n_tok * n_head + head_idx;
    const uint s_base_idx = (s_off + seq_idx * nb03 + head_idx * nb02) / 4;

    const uint stride_x = nb12 / 4;
    const uint stride_dt = nb21 / 4;
    const uint stride_B = nb42 / 4;
    const uint stride_C = nb52 / 4;
    const uint stride_y = n_head;

    /* Load per-head state (d_state=16) and A (d_state=16) */
    float state[D_STATE];
    float regA[D_STATE];
    [[unroll]] for (uint j = 0; j < D_STATE; j++) {
        state[j] = s0[s0_base_idx + j];
        regA[j]  = A[A_base_idx + j];
    }

    /* Scan loop over tokens */
    for (uint i = 0; i < n_tok; i++) {
        /* Load B and C into shared memory */
        if (gl_LocalInvocationID.x < D_STATE) {
            smemB[gl_LocalInvocationID.x] = B[B_base_idx + i * stride_B + gl_LocalInvocationID.x];
            smemC[gl_LocalInvocationID.x] = C[C_base_idx + i * stride_C + gl_LocalInvocationID.x];
        }
        barrier();

        float dt_soft_plus = softplus(dt[dt_base_idx + i * stride_dt]);
        float x_dt = x[x_base_idx + i * stride_x] * dt_soft_plus;

        float y = 0.0;
        [[unroll]] for (uint j = 0; j < D_STATE; j++) {
            state[j] = state[j] * exp(dt_soft_plus * regA[j]) + smemB[j] * x_dt;
            y += state[j] * smemC[j];
        }
        barrier();

        d[y_base_idx + i * stride_y] = y;
    }

    /* Write back final state */
    [[unroll]] for (uint j = 0; j < D_STATE; j++) {
        d[s_base_idx + j] = state[j];
    }
}
